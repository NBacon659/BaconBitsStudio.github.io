---
// Container.astro — width-constraining layout primitive (§5 SRP, §13). One job:
// cap line length and apply the responsive gutter. No content, no decoration.
interface Props {
  as?: string;
  class?: string;
}
const { as: Tag = "div", class: className = "" } = Astro.props;
---

<Tag class:list={["container", className]}>
  <slot />
</Tag>

<style>
  .container {
    width: min(100%, var(--layout-max));
    padding-inline: var(--layout-gutter);
    margin-inline: auto;
  }
</style>
